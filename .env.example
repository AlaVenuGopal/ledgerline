# LedgerLine Environment Variables Example
# Copy this file to .env and configure your production credentials
# NEVER commit real credentials to Git

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ledgerline
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
JWT_SECRET=replace_with_a_64_character_base64_encoded_secure_random_key
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Frontend Environment (frontend/.env)
VITE_API_BASE_URL=http://localhost:8080
